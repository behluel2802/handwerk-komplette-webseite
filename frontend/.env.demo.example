# Vorlage für die Betreiberdaten der öffentlichen Demo (Impressum § 5 DDG, Datenschutz).
# Kopieren nach frontend/.env.demo.local (steht auf .gitignore) und echte Werte eintragen.
# In GitHub Actions dieselben Namen als Repository-Variablen anlegen (Settings → Secrets and variables → Actions → Variables).
# Alle Werte sind Pflicht; fehlt einer, bricht „npm run build:demo“ ab.

# Vor- und Nachname
OPERATOR_NAME=
# Ladungsfähige Anschrift (kein Postfach)
OPERATOR_STREET=
OPERATOR_ZIP=
OPERATOR_CITY=
# E-Mail, am besten eine eigene Alias-Adresse (Briefing R4)
OPERATOR_EMAIL=
# Telefon als zweiter schneller Kontaktweg (§ 5 Abs. 1 Nr. 2 DDG), z. B. 0170 1234567
OPERATOR_PHONE=
# Bundesland-Kürzel für die Datenschutz-Aufsichtsbehörde: BW BY BE BB HB HH HE MV NI NW RP SL SN ST SH TH
OPERATOR_STATE=

# Basispfad auf GitHub Pages (Projektseite)
BASE=/handwerk-komplette-webseite/
