{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/impressum/",
        "http://localhost:3000/datenschutz/",
        "http://localhost:3000/danke/",
        "http://localhost:3000/leistungen/smart-home/",
        "http://localhost:3000/404.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.9
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "localhost:3000/$",
          "assertions": {
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
