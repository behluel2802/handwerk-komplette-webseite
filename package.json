{
  "name": "handwerk-komplette-webseite",
  "private": true,
  "description": "Website-Vorlage für Handwerksbetriebe: statisches Frontend (Vite) + kleines Node-Backend.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently --names web,api --prefix-colors yellow,blue --kill-others-on-fail \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "build": "npm run build -w frontend",
    "start": "npm start -w backend",
    "test": "npm test --workspaces --if-present",
    "images": "npm run images -w frontend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "type": "module"
}
